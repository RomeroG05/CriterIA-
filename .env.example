# Copia este archivo como .env y ajusta los valores.

# --- Django ---
DJANGO_DEBUG=true
# Obligatoria si DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- IA local (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

# --- Búsqueda en los PDF ---
# Similitud mínima para considerar que hay evidencia suficiente.
RAG_MIN_SIMILARITY=0.50

# --- Gemini (solo para generar imagen y audio a partir de respuestas ya fundamentadas) ---
# Las imágenes no tienen capa gratuita: requieren facturación activa en Google AI Studio.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_DAILY_IMAGE_LIMIT=5
GEMINI_DAILY_AUDIO_LIMIT=20

# --- Voz local (faster-whisper): tiny, base, small, medium ---
WHISPER_MODEL=small
